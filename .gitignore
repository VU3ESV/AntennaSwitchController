# macOS
.DS_Store

# Swift Package Manager build / local artifacts
**/.build/
App/dist/
*.swiftpm

# XcodeGen-generated project for the plugin .appex (regenerate with xcodegen)
App/Xcode/*.xcodeproj/

# Generated icon staging (regenerate with App/Resources/make-icon.swift); keep the .icns
App/Resources/AppIcon.iconset/

# Arduino build cache (arduino-cli builds outside the tree by default)
build/
*.bin

# local suite-integration workspace (scratch)
.suite/
